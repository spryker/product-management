{% set hasMetaAttributes = metaAttributes is defined and metaAttributes is not empty %}

{% embed '@Gui/Partials/widget.twig' with { widget_title: 'Attributes' } %}
    {% block widget_content %}

        {% for localeName,attributes in productAttributes %}
            {% embed '@Gui/Partials/localized-ibox.twig' with {'collapsed': (not loop.first)} %}
                {% block title %}
                    {% if localeName == 'default' %}
                        {{ 'Default' | trans }}
                    {% else %}
                        {{ parent() }}
                    {% endif %}
                {% endblock %}

                {% block content %}
                    {% set attributeRowsTemplates = hasMetaAttributes
                        ? ['@ProductExperienceManagement/ProductManagement/_partials/info-attribute-rows.twig', '@ProductManagement/View/_partials/info-attribute-rows.twig']
                        : ['@ProductManagement/View/_partials/info-attribute-rows.twig'] %}

                    {% include attributeRowsTemplates with {
                        attributes: attributes,
                        metaAttributes: hasMetaAttributes ? metaAttributes : [],
                    } %}

                {% endblock %}
            {% endembed %}
        {% endfor %}

    {% endblock %}
{% endembed %}
